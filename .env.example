# ==============================================================================
# Enterprise RAG & Tabular Execution Harness - Environment Configuration
# ==============================================================================

# Server & General
APP_ENV=production
DEBUG=False
HOST=0.0.0.0
PORT=8000
TIMEZONE=Asia/Ho_Chi_Minh
MAX_FILE_SIZE_MB=30
IS_PUBLIC_DEFAULT=False

# Storage Locations (Air-Gapped Local Paths)
DATA_RAW_DIR=./data/raw
DATA_PARQUET_DIR=./data/parquet
LOCAL_MODELS_DIR=./models

# LLM (OpenAI-compatible server e.g. vLLM / Ollama / Local Gateway)
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_API_KEY=EMPTY
LLM_MODEL_NAME=gpt-oss-120b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# Metadata DB: PostgreSQL 16 (Native)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rag_enterprise
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Vector DB: Qdrant
# VECTOR_STORE_MODE: "binary" (Qdrant native binary service on port 6333) or "embedded" (local path)
VECTOR_STORE_MODE=binary
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=enterprise_knowledge
QDRANT_LOCAL_PATH=./data/qdrant_storage

# Embeddings & Reranker Local Weights (Air-Gapped)
# GPU A400 (4GB VRAM): Embedder on GPU, Reranker & OCR on CPU
BGE_M3_MODEL_PATH=./models/BAAI_bge-m3
BGE_M3_DEVICE=cuda:0
RERANKER_MODEL_PATH=./models/BAAI_bge-reranker-v2-m3
RERANKER_DEVICE=cpu
RERANKER_THRESHOLD=0.35
DOCLING_MODELS_PATH=./models/docling
VIETOCR_WEIGHTS_PATH=./models/vietocr/vgg_seq2seq.pth

# Tabular Engine Execution Sandbox
ENABLE_SYNTHETIC_FEWSHOT=True
SYNTHETIC_FEWSHOT_COUNT=6
PANDAS_TIMEOUT_SECONDS=15
PANDAS_MAX_RAM_MB=512
DUCKDB_MAX_MEMORY=2GB
DUCKDB_THREADS=4
DUCKDB_MAX_OUTPUT_ROWS=10000

# Authentication & RBAC (Internal SSO / Reverse Proxy Headers)
AUTH_MODE=header
HEADER_USER_ID=X-User-Id
HEADER_DEPARTMENT_ID=X-Department-Id
HEADER_USER_ROLE=X-User-Role
